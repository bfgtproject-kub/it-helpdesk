# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริงจาก Supabase (Project Settings > Database > Connection string)
# ใช้แบบ Session pooler ไม่ใช่ Direct connection (เครือข่ายส่วนใหญ่ไม่รองรับ IPv6 ที่ direct connection ต้องใช้)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres"

# สร้างด้วย: openssl rand -base64 32 (หรือให้ Claude สร้างให้)
AUTH_SECRET=""

# ใช้ตอน Phase 2 (console.anthropic.com)
ANTHROPIC_API_KEY=""
